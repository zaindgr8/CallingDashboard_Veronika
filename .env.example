RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxx
# Optional second Retell key (reserved for webhook verification)
RETELL_SECRET_KEY=
DASHBOARD_USERNAME=Veronika
DASHBOARD_PASSWORD=choose-a-strong-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional: limit this dashboard to specific agents (comma-separated agent IDs)
ALLOWED_AGENT_IDS=
# Optional: turns on AI lead briefs (summary, intent, talking points)
ANTHROPIC_API_KEY=
# Optional: model for AI briefs (default claude-opus-5-5)
ANTHROPIC_MODEL=
# Optional: folder for lead and campaign data (default ./data). Use a persistent volume in production.
DATA_DIR=
